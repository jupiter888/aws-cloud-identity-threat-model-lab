
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadApprovedResearchObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::ari-approved-research/*"
    },
    {
      "Sid": "ListApprovedResearchBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ari-approved-research"
    }
  ]
}
